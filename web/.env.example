# Copy to web/.env.local (gitignored). Never commit real keys.

# OpenAI — GPT chat, executive task planning, transcription, and spoken confirmations.
# Server-only. Use this same variable in your shell/web/.env.local and on Vercel.
OPENAI_API_KEY=

# Optional model/voice overrides. The defaults work with only OPENAI_API_KEY set.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_VOICE_MODEL=gpt-realtime-2.1-mini
OPENAI_VOICE=marin

# Optional: where desk state is written (default: web/data/desk-state.json, gitignored).
DESK_STATE_PATH=
