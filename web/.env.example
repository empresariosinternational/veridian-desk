# Copy to web/.env.local (gitignored). Never commit real keys.

# Optional OpenAI key — GPT chat and executive task planning only.
# Microphone recognition, spoken confirmations, and desk-rule filing need no key.
# Server-only. Use this same variable in your shell/web/.env.local and on Vercel.
OPENAI_API_KEY=

# Optional chat model override.
OPENAI_MODEL=gpt-4.1-mini

# Optional: where desk state is written (default: web/data/desk-state.json, gitignored).
DESK_STATE_PATH=
