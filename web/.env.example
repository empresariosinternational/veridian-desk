# Copy to web/.env.local (gitignored). Never commit real keys.

# Deepgram — the desk's voice: hears push-to-talk (nova-3) and speaks the confirmation (Aura-2). Server-only.
DEEPGRAM_API_KEY=

# Optional: Deepgram voices for the spoken confirmation (defaults: aura-2-thalia-en, aura-2-celeste-es).
DEEPGRAM_VOICE_EN=
DEEPGRAM_VOICE_ES=

# Optional: where desk state is written (default: web/data/desk-state.json, gitignored).
DESK_STATE_PATH=
